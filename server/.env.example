# Copier ce fichier en .env et compléter avec vos identifiants réels.
# Ne jamais committer le fichier .env (voir .gitignore).

# Port d'écoute du serveur
PORT=3000

# Domaine autorisé à appeler l'API (celui où le site est hébergé)
ALLOWED_ORIGIN=https://www.atelier-meridien.fr

# --- SMTP (envoi d'e-mails) ---------------------------------------------
# Exemple avec un compte Gmail (mot de passe d'application requis) :
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=votre-adresse@gmail.com
#   SMTP_PASS=xxxxxxxxxxxxxxxx
#
# Ou avec un fournisseur transactionnel (Brevo, OVH, Infomaniak, etc.) :
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Adresse affichée comme expéditeur
MAIL_FROM="Site Atelier Méridien" <no-reply@atelier-meridien.fr>

# Adresse qui reçoit les messages du formulaire de contact
MAIL_TO=contact@atelier-meridien.fr
